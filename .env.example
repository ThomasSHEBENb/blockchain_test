# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polymarket_indexer
DB_USER=postgres
DB_PASSWORD=admin123

# Polygon JSON-RPC Endpoints (comma-separated, prioritized with fallback)
POLYGON_RPC_URLS=https://gateway.tenderly.co/public/polygon,https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org,https://polygon-rpc.com,https://rpc.ankr.com/polygon

# Target Wallet Address
TARGET_WALLET=0x46b353667fd7d846af3bbeda6584b0e5b883d3de

# Indexing Parameters
START_BLOCK=80000000
CHUNK_SIZE=3000
MAX_RETRIES=5
INITIAL_BACKOFF=1.0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
